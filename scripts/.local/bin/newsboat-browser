#!/usr/bin/env sh

# newsboat-browser -- dispatch URLs opened in newsboat to the right app.
# Requires: mpv (youtube), firefox (fallback).

if [ "$#" -ne 1 ]; then
	echo "usage: $(basename "$0") [URL]" 1>&2
	exit 1
fi

URL="$1"

notify() {
	ICON="$HOME/.local/share/icons/$1.png"

	if [ -f "$ICON" ]; then
		notify-send -i "$ICON" "Newsboat" "Opening $URL in $1" -t 3000
	else
		notify-send "Newsboat" "Opening $URL in $1" -t 3000
	fi
}

rule() {
	REGEX="$1"
	HANDLER="$2"

	if expr "$URL" : "$REGEX" >/dev/null; then
		if ! command -v "$HANDLER" >/dev/null 2>&1; then
			echo "newsboat-browser: missing handler '$HANDLER' for $URL" 1>&2
			exit 1
		fi

		notify "$HANDLER"
		"$HANDLER" "$URL" &
		exit 0
	fi
}

rule 'https://\(www\.\|m\.\)\{0,1\}youtube\.com/' mpv
rule 'https://youtu\.be/'                          mpv
rule '.*'                         firefox
