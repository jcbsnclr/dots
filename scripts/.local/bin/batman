#!/usr/bin/env sh
# batman -- page man output through bat, stripping groff overstrikes.
# Based on https://github.com/sharkdp/bat/issues/1145 (@lahwaacz).

# man(1) passes the formatted page as a file argument, not on stdin.
# file="${1:-/dev/stdin}"

# if command -v col >/dev/null 2>&1; then
# 	col -bx "$file" | bat --language man --style plain --pager "$PAGER"
# else
# 	# Fallback when col(1) is unavailable: collapse "x\bx" overstrikes,
# 	# then drop any remaining backspaces.
# 	sed "s/.$(printf '\b')//g" "$file" | tr -d '\b' | bat --language man --style plain --pager "$PAGER"
# fi

exec sed 's/.\x08//g' "$@" |
      bat --language man --style plain --pager "$PAGER"
