{
    "layer": "top",        // Above or below windows [top/bottom]
    "position": "bottom",     // [top/bottom/left/right]
    "mode": "dock",           // [dock/hide/invisible/overlay]

    "exclusive": true,
    "gtk-layer-shell": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "height": 32,

    "modules-left": [
        "disk",
        "wireplumber",
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "custom/iwd",
        "battery",
        "tray",
        "clock"
    ],

    "custom/iwd": {
        "exec": "$HOME/.config/waybar/scripts/iwd.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "iwgtk",
        "tooltip": true
    },

    "wireplumber": {
        "format": "<span font_family='Font Awesome 7 Free'></span> {volume}%",
        "format-muted": "<span font_family='Font Awesome 7 Free'></span> MUTED",
        "on-click": "pavucontrol-qt",
        "max-volume": 100,
        "scroll-step": 0
    },

    "disk": {
        "interval": 30,
        "format": "<span font_family='Font Awesome 7 Free'></span> {free}",
        "path": "/home",
        "tooltip": false,
        "unit": "GB"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "<span font_family='Font Awesome 7 Free'>{icon}</span> {capacity}%",
        "format-charging": "<span font_family='Font Awesome 7 Free'>\uf0e7</span> {capacity}%",
        "format-plugged": "<span font_family='Font Awesome 7 Free'>\uf1e6</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo} · {power}W"
    },

    "wlr/taskbar": {
        "format": "{icon} {name:.20}",
        // "format": "{icon}",
        "icon-size": 21,
        "spacing": 10,
        "on-click-middle": "close",
        "tooltip": false,
        "ignore-list": [],
        "on-click": "activate",
        // "active-first": true,
        // "sort-by-app-id": true,
        "rewrite": {
            "^(.{16}).+$": "$1…"
        }
    },

    "tray": {
        "icon-size": 21,
        "show-passive-items": true,
        "spacing": 10
    },

    "clock": {
        "format": "<span font_family='Font Awesome 7 Free'></span> {:%Y-%m-%d │ %H:%M %Z}",
        "tooltip-format": "<tt>{calendar}</tt>",

        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 0,

            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'>{}</span>",
                "weeks": "<span color='#99ffdd'>W{}</span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ffcc66'><b><u>{}</u></b></span>"
            }
        }
    },
}
