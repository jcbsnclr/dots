#!/usr/bin/env sh

# start gui runlevel
mkdir -p "$HOME/.local/state/log"
openrc --user gui >/dev/null 2>&1 &

# GTK4/libadwaita apps and the settings portal (Firefox) read these, not
# gtk-*/settings.ini
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  gsettings set org.gnome.desktop.interface cursor-theme capitaine-cursors-dark
  gsettings set org.gnome.desktop.interface cursor-size 24
  gsettings set org.gnome.desktop.interface icon-theme Adwaita
fi

# load wallpaper
wall="$(xdg-user-dir PICTURES)/wall.jpg"
if [ -f "$wall" ]; then
  swaybg -i "$wall" -m fill >/dev/null 2>&1 &
fi

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  # ssh clients, KeePassXC and the proxy all talk to the front socket
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/keepass-ssh.sock"

  # real ssh-agent (KeePassXC hands keys to this when the database is unlocked)
  real="$XDG_RUNTIME_DIR/keepass-ssh-real.sock"
  if command -v ssh-agent >/dev/null 2>&1; then
    if [ -S "$real" ]; then
      # ssh-add exits 2/124 when the socket is not answering, 0/1 when alive
      SSH_AUTH_SOCK="$real" timeout 2 ssh-add -l >/dev/null 2>&1
      case $? in 2 | 124) rm -f "$real" ;; esac
    fi
    [ -S "$real" ] || ssh-agent -a "$real" >/dev/null
  fi

  # proxy that raises the KeePassXC unlock dialog when ssh needs a locked key.
  # Replace an instance from an earlier GUI session: it would otherwise keep
  # the old session's D-Bus/Wayland environment (and its log fd).
  proxy_pid="$XDG_RUNTIME_DIR/keepassxc-ssh-proxy.pid"
  if [ -x "$HOME/.local/bin/keepassxc-ssh-proxy" ]; then
    if [ -s "$proxy_pid" ]; then
      old=$(cat "$proxy_pid" 2>/dev/null)
      cmd=$(tr '\0' ' ' <"/proc/$old/cmdline" 2>/dev/null || true)
      case "$cmd" in
      *keepassxc-ssh-proxy*)
        kill "$old" 2>/dev/null
        i=0
        while kill -0 "$old" 2>/dev/null && [ "$i" -lt 20 ]; do
          sleep 0.1
          i=$((i + 1))
        done
        kill -9 "$old" 2>/dev/null || true
        ;;
      esac
    fi
    rm -f "$proxy_pid"
    "$HOME/.local/bin/keepassxc-ssh-proxy" >"$HOME/.local/state/log/keepassxc-ssh-proxy.log" 2>&1 &
  fi
fi

if [ -d "$HOME/.config/autostart" ]; then
  for f in "$HOME/.config/autostart/"*.desktop; do
    [ -e "$f" ] || continue
    gtk-launch "$(basename "$f" .desktop)"
  done
fi

dbus-update-activation-environment --all >/dev/null 2>&1 &
