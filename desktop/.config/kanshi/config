# Global defaults + aliases. Model-only globs ignore the serial, so the same
# monitors match on any host or port. Use the full serial instead of "*" to
# pin exact units.
output "Acer Technologies B247Y E *" {
	mode 1920x1080@60Hz
	scale 1
	alias $acer
}

output "Philips Consumer Electronics Company PHL 227E6 *" {
	mode 1920x1080@60Hz
	scale 1
	alias $philips
}

output eDP-1 {
	mode 3840x2400@60Hz
	scale 2
}

profile x1-carbon {
	output eDP-1 position 0,0
}

profile ryzen-desktop {
	output $acer {
		mode 1920x1080@100Hz
		position 0,0
	}
	output $philips position 1920,0
}

# Laptop docked to both monitors, internal panel off.
profile laptop-both {
	output eDP-1 disable
	output $acer position 0,0
	output $philips position 1920,0
}

# Laptop docked to one monitor, internal panel off.
profile laptop-acer {
	output eDP-1 disable
	output $acer position 0,0
}

profile laptop-philips {
	output eDP-1 disable
	output $philips position 0,0
}
