#!/bin/sh
# On-screen display for media keys, shown via mako notifications.
#
# Usage:
#   osd volume up|down|mute
#   osd mic mute
#   osd brightness up|down

sink='@DEFAULT_AUDIO_SINK@'
source='@DEFAULT_AUDIO_SOURCE@'
step='5%'

notify() {
	# $1 icon  $2 summary  $3 body  $4 tag  $5 value(0-100)
	notify-send -a osd -i "$1" \
		-h "int:value:$5" \
		-h "string:x-canonical-private-synchronous:$4" \
		"$2" "$3"
}

case "$1" in
volume)
	case "$2" in
	up)   wpctl set-volume -l 1.0 "$sink" "$step+" ;;
	down) wpctl set-volume "$sink" "$step-" ;;
	mute) wpctl set-mute "$sink" toggle ;;
	*)
		echo "usage: osd volume up|down|mute" >&2
		exit 2
		;;
	esac
	out=$(wpctl get-volume "$sink")
	pct=$(printf '%s' "$out" | awk '{printf "%d", $2 * 100}')
	[ "$pct" -gt 100 ] && pct=100
	if printf '%s' "$out" | grep -q MUTED; then
		notify audio-volume-muted Volume "Muted" volume "$pct"
	elif [ "$pct" -eq 0 ]; then
		notify audio-volume-muted Volume "0%" volume "$pct"
	elif [ "$pct" -lt 34 ]; then
		notify audio-volume-low Volume "$pct%" volume "$pct"
	elif [ "$pct" -lt 67 ]; then
		notify audio-volume-medium Volume "$pct%" volume "$pct"
	else
		notify audio-volume-high Volume "$pct%" volume "$pct"
	fi
	;;
mic)
	wpctl set-mute "$source" toggle
	out=$(wpctl get-volume "$source")
	if printf '%s' "$out" | grep -q MUTED; then
		notify microphone-sensitivity-muted-symbolic Microphone "Muted" mic 0
	else
		notify microphone-sensitivity-high-symbolic Microphone "Unmuted" mic 100
	fi
	;;
brightness)
	case "$2" in
	up)   sign='+' ;;
	down) sign='-' ;;
	*)
		echo "usage: osd brightness up|down" >&2
		exit 2
		;;
	esac
	if ls /sys/class/backlight/* >/dev/null 2>&1 &&
	   command -v brightnessctl >/dev/null 2>&1; then
		brightnessctl set "$step$sign" >/dev/null
		cur=$(brightnessctl get)
		max=$(brightnessctl max)
		pct=$(( cur * 100 / max ))
	elif command -v ddcutil >/dev/null 2>&1; then
		# external monitors: DDC/CI VCP 0x10 (luminance) on every display
		pct=
		for d in $(ddcutil detect --brief 2>/dev/null |
			awk '/^Display [0-9]+/ { print $2 }'); do
			ddcutil --display "$d" --noverify setvcp 10 "$sign" "${step%\%}" >/dev/null 2>&1
			[ -n "$pct" ] || pct=$(ddcutil --display "$d" --brief getvcp 10 2>/dev/null |
				awk '{ if ($5 > 0) printf "%d", $4 * 100 / $5 }')
		done
		[ -n "$pct" ] || {
			notify display-brightness-symbolic Brightness "No DDC/CI display" brightness 0
			exit 1
		}
	else
		notify display-brightness-symbolic Brightness "No backlight" brightness 0
		exit 1
	fi
	notify display-brightness-symbolic Brightness "$pct%" brightness "$pct"
	;;
*)
	echo "usage: osd volume up|down|mute | mic mute | brightness up|down" >&2
	exit 2
	;;
esac
