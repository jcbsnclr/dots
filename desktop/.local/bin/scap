#!/usr/bin/env sh

set -e
set -o pipefail

usage() {
  echo "usage: $(basename "$0") [all|area|output]" 1>&2
  exit 1
}

getgeom() {
  slurp "$@"
}

if [ "$#" -ne 1 ]; then
  usage
fi

case "$1" in
  all)
    grim - | wl-copy
    ;;

  area)
    GEOM="$(getgeom)"
    grim -g "$GEOM" - | wl-copy
    ;;

  output)
    GEOM="$(getgeom -o)"
    grim -g "$GEOM" - | wl-copy
    ;;

  *)
    usage
esac

dir="${GRIM_DEFAULT_DIR:-$HOME/media/pictures/screenshots}"
OUTP="$dir/$(date +%Y-%m-%d_%H:%M:%S).png"
mkdir -p "$dir"
wl-paste > "$OUTP"
notify-send -t 3000 -i "$OUTP" "Screenshot Taken" "$OUTP"
