#!/usr/bin/env sh
# colour-picker -- copy the colour of a pixel to the clipboard.
# Usage: colour-picker ["X,Y 1x1"]   (default: pick a pixel with slurp)
# Requires: grim, slurp, ImageMagick (magick), wl-copy.

for dep in grim slurp magick wl-copy; do
	if ! command -v "$dep" >/dev/null 2>&1; then
		echo "colour-picker: missing dependency '$dep'" 1>&2
		exit 1
	fi
done

if [ "$#" -gt 1 ]; then
	echo "usage: $(basename "$0") [\"X,Y 1x1\"]" 1>&2
	exit 1
fi

if [ "$#" -eq 1 ]; then
	GEOM="$1"
else
	GEOM="$(slurp -p)" || {
		echo "colour-picker: cancelled" 1>&2
		exit 1
	}
fi

grim -g "$GEOM" -t ppm - \
	| magick - -format '%[pixel:p{0,0}]' txt:- \
	| wl-copy
